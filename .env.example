# Copy to .env for local runs. Never commit a real .env. Empty values are treated as unset.
# `pnpm dev` and `pnpm start` load .env; Docker Compose reads it for ${VAR} interpolation.
# On Vercel set these in Project -> Settings -> Environment Variables instead.

# Public URL of the dashboard INCLUDING any base path; used for links in alerts.
# Empty: on Vercel, https://<production domain>; locally, http://localhost:<PORT><BASE_PATH>.
APP_URL=
# Path prefix the app serves under (dashboard, /api/*, /healthz, assets). Empty = serve at root (Vercel).
BASE_PATH=

# Database. libsql/Turso URL in production (libsql://<db>-<org>.turso.io) plus its auth token.
# Empty: a local SQLite file at $DATA_DIR/status.db (not allowed on Vercel).
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Directory for the local SQLite file; used only when DATABASE_URL is empty.
DATA_DIR=./data

# Shared secret for GET/POST /api/poll; the scheduler sends `Authorization: Bearer <CRON_SECRET>`.
# At least 16 characters (e.g. `openssl rand -hex 32`). Empty = /api/poll answers 503.
CRON_SECRET=

# Slack incoming webhook URL. Unset = alert payloads are logged instead of posted.
SLACK_WEBHOOK_URL=

# HTTP port for pnpm dev/start (1-65535). Not used on Vercel; Compose pins the container to 8080.
PORT=8080
# Interface to bind for pnpm dev/start. Not used on Vercel; Compose pins the container to 0.0.0.0.
HOST=0.0.0.0
# Seconds between poll cycles (60-600). Drives the pnpm dev/start loop and the /healthz stall threshold.
POLL_INTERVAL_SECONDS=180
# Per-request fetch timeout in milliseconds (1000-60000). Capped at 4000 on Vercel.
FETCH_TIMEOUT_MS=10000
# Minutes between reminder alerts while a vendor stays non-operational (5-1440).
ALERT_REMINDER_MINUTES=60
# Consecutive unknown results required before an "unreachable" alert (1-20).
UNKNOWN_ALERT_THRESHOLD=3
# Days of check history kept in the database (1-365).
HISTORY_RETENTION_DAYS=30
# Path to the vendors file.
VENDORS_FILE=./vendors.yaml

# Optional email alerts. Set SMTP_HOST to enable; SMTP_FROM and SMTP_TO are then required.
SMTP_HOST=
# SMTP port (1-65535).
SMTP_PORT=587
# true for implicit TLS (usually port 465), false for STARTTLS.
SMTP_SECURE=false
# SMTP username (optional).
SMTP_USER=
# SMTP password (optional).
SMTP_PASS=
# From address.
SMTP_FROM=
# Recipients, comma separated.
SMTP_TO=
