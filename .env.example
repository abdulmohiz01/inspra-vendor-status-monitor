# Copy to .env for local runs. Never commit a real .env. Empty values are treated as unset.

# HTTP port the server listens on (1-65535).
PORT=8080
# Interface to bind.
HOST=0.0.0.0
# Public URL of the dashboard INCLUDING the base path; used for links in alerts.
# Locally set http://localhost:<port>/insprastatus (e.g. http://localhost:4180/insprastatus).
APP_URL=https://hub.automateaccelerator.com/insprastatus
# Path prefix the app serves under (dashboard, /api/status, /healthz, assets). Empty = serve at root.
BASE_PATH=/insprastatus
# Seconds between poll cycles (60-600).
POLL_INTERVAL_SECONDS=180
# Per-request fetch timeout in milliseconds (1000-60000).
FETCH_TIMEOUT_MS=10000
# Minutes between reminder alerts while a vendor stays non-operational (5-1440).
ALERT_REMINDER_MINUTES=60
# Consecutive unknown results required before an "unreachable" alert (1-20).
UNKNOWN_ALERT_THRESHOLD=3
# Days of check history kept in SQLite (1-365).
HISTORY_RETENTION_DAYS=30
# Directory for the SQLite database (docker-compose.yml pins this to /data).
DATA_DIR=./data
# Path to the vendors file.
VENDORS_FILE=./vendors.yaml

# Slack incoming webhook URL. Unset = alert payloads are logged instead of posted.
SLACK_WEBHOOK_URL=

# Optional email alerts. Set SMTP_HOST to enable; SMTP_FROM and SMTP_TO are then required.
SMTP_HOST=
# SMTP port (1-65535).
SMTP_PORT=587
# true for implicit TLS (usually port 465), false for STARTTLS.
SMTP_SECURE=false
# SMTP username (optional).
SMTP_USER=
# SMTP password (optional).
SMTP_PASS=
# From address.
SMTP_FROM=
# Recipients, comma separated.
SMTP_TO=
